# PostgreSQL connection used by Prisma. Keep local credentials out of Git.
DATABASE_URL="postgresql://creatorhire:creatorhire@localhost:5432/creatorhire?schema=public"

# Required in production to validate Telegram WebApp initData. Never expose it to the browser.
TELEGRAM_BOT_TOKEN=""

# Allows the browser shell to run locally without Telegram. Must be false in production.
TELEGRAM_DEV_MODE="true"

# Reject initData whose auth_date is older than this number of seconds.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="86400"

# Set to an error collector DSN only after the vendor and data-processing terms are approved.
ERROR_REPORTING_DSN=""
